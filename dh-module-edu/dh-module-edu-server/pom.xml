<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>dh-module-edu</artifactId>
        <groupId>cn.dh.edu</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>

    <artifactId>dh-module-edu-server</artifactId>

    <name>${project.artifactId}</name>
    <description>
        edu 模块，教培相关业务（骨架预留）。
    </description>

    <dependencies>
        <!-- Spring Cloud 基础 -->
        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-spring-boot-starter-env</artifactId>
        </dependency>

        <!-- 依赖服务 -->
        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-module-system-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-module-infra-api</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-module-edu-api</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-common-server</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-module-bpm-api</artifactId>
            <version>${revision}</version>
        </dependency>


        <!-- 业务组件 -->
        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-spring-boot-starter-biz-data-permission</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-spring-boot-starter-biz-tenant</artifactId>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- RPC 远程调用相关 -->
        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-spring-boot-starter-rpc</artifactId>
        </dependency>

        <!-- Job 定时任务相关 -->
        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-spring-boot-starter-job</artifactId>
        </dependency>

        <!-- 消息队列相关 -->
        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-spring-boot-starter-mq</artifactId>
        </dependency>


        <!-- 工具类相关 -->
        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-spring-boot-starter-excel</artifactId>
        </dependency>

        <!-- 监控相关 -->
        <dependency>
            <groupId>cn.dh.edu</groupId>
            <artifactId>dh-spring-boot-starter-monitor</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- 设置构建的 jar 包名 -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- 打包 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <configuration>
                    <!-- 单体模式下跳过 repackage，由 dh-server 统一打包 -->
                    <skip>${skip.repackage}</skip>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
